# App Environment
ENVIRONMENT=development
APP_NAME=FinFlow
DEBUG=true
PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./finflow.db
# For PostgreSQL: postgresql+asyncpg://finflow_user:finflow_password@localhost:5432/finflow_db

# MinIO / S3 Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadminpassword
MINIO_BUCKET=finflow-documents
MINIO_SECURE=false

# LLM & LiteLLM Settings
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Langfuse Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Financial Governance & Policy Thresholds
MAX_AUTO_APPROVE_AMOUNT=5000.00
HIGH_RISK_THRESHOLD_AMOUNT=25000.00
PRICE_VARIANCE_TOLERANCE_PCT=0.05
QUANTITY_VARIANCE_TOLERANCE_PCT=0.00
