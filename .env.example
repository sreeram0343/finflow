# Database Connections
DATABASE_URL=postgresql+asyncpg://finflow_user:finflow_password@localhost:5432/finflow_db

# MinIO Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123
MINIO_BUCKET_NAME=invoices

# LiteLLM Keys
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-your-anthropic-key

# App Environment
ENVIRONMENT=development
APP_NAME=FinFlow
DEBUG=true
PORT=8000

# Langfuse Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Financial Governance & Policy Thresholds
MAX_AUTO_APPROVE_AMOUNT=5000.00
HIGH_RISK_THRESHOLD_AMOUNT=25000.00
PRICE_VARIANCE_TOLERANCE_PCT=0.05
QUANTITY_VARIANCE_TOLERANCE_PCT=0.00
